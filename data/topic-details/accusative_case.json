{
  "id": "accusative_case",
  "title": "Accusative Case",
  "level": "A1.2",
  "group": "cases",
  "summary": "The accusative case is used for the direct object in a sentence — the person or thing directly affected by an action. It answers the question 'Wen?' or 'Was?'.",
  "whyItMatters": "Accusative is essential for everyday communication. You need it to express what you see, buy, have, or interact with. It is one of the most frequently used structures in German.",
  "mentalModel": [
    {
      "title": "Target of the action",
      "content": "The accusative marks the target that receives the action. Example: 'Ich sehe den Mann' — the man is being seen."
    },
    {
      "title": "Contrast with dative",
      "content": "Accusative = direct object (what is affected). Dative = indirect object (who receives something)."
    }
  ],
